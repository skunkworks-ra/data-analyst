#!/bin/sh
# analyst-driver — run the external loop from any directory.
#
# `pixi run` searches the current directory and its parents for a manifest, so
# invoking it from a data directory fails with:
#
#     could not find pixi.toml or pyproject.toml with tool.pixi at directory ...
#
# This wrapper resolves the repository from its own location and passes the
# manifest explicitly, so you can drive a run from wherever the data lives.
#
# Install:
#     ln -s ~/src/skunkworks-ra/radio-analyst/bin/analyst-driver ~/bin/analyst-driver
#
# Usage (identical to the task, from anywhere):
#     analyst-driver init --run-id NAME --ms PATH --goal TEXT
#     analyst-driver run  --run <run_dir>
#     analyst-driver status --run <run_dir>

set -eu

# Resolve this script through any symlinks, so the ~/bin symlink above works.
script=$0
while [ -L "$script" ]; do
    dir=$(cd -P "$(dirname "$script")" && pwd)
    script=$(readlink "$script")
    case $script in
        /*) ;;
        *) script="$dir/$script" ;;
    esac
done
repo=$(cd -P "$(dirname "$script")/.." && pwd)

if ! command -v pixi >/dev/null 2>&1; then
    echo "analyst-driver: pixi is not on PATH" >&2
    exit 127
fi

exec pixi run --manifest-path "$repo/pixi.toml" analyst-driver "$@"
